# ZAP-Hosting 保活脚本配置文件
# 复制此文件为 .env 并填写您的信息；脚本读取系统环境变量
# Bash 中先执行: set -a; source .env; set +a

# YesCaptcha API Key (仅用于登录表单的 reCAPTCHA；Cloudflare 使用浏览器验证)
# 获取地址: https://yescaptcha.com
YESCAPTCHA_API_KEY=your_api_key_here

# 可选浏览器代理，不配置时直接连接；Cloudflare 验证不调用 YesCaptcha API。
# 支持 HTTP/HTTPS（可带认证）或无密码 SOCKS5，代理地址仅保存到 Secrets/环境变量。
# 示例格式：http://username:password@proxy.example.com:8080
ZAP_PROXY_URL=

# 账号配置 (支持多账号，用逗号分隔)
# 格式: 邮箱:密码,邮箱:密码,...
# 示例: user1@example.com:password1,user2@example.com:password2
ZAP_ACCOUNT='your_email@example.com:your_password'

# VPS 详情页停留时间 (秒，可选，默认10)
STAY_DURATION=10
LOGIN_WAIT_DURATION=3
ZAP_BASE_URL=https://legacy.zap-hosting.com
# 可选：指定 VPS 详情页；留空则在 Dashboard 查找
ZAP_VPS_URL=

# 邮件通知：QQ SMTP 使用服务授权码，不能使用邮箱登录密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TO=

# Telegram 通知配置 (可选)
# Bot Token: 通过 @BotFather 创建机器人获取
# Chat ID: 通过 @userinfobot 获取你的用户 ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
